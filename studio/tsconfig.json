{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@calfnxt/ui": ["../ui/src/studioApi.ts"],
      "@calfnxt/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src"]
}
